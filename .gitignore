.kothar-rag.log

# Backups locais
backups/
*.tar.gz
*.backup
.kothar/backups/

# Node
node_modules/
.npm
.yarn

# Docker
.dockerignore

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

