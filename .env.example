# =============================================================
#  KOTHAR v4.0 — Variáveis de Ambiente
#  Copie este arquivo para .env e preencha os valores reais
# =============================================================

# --- PostgreSQL ---
POSTGRES_USER=kothar
POSTGRES_PASSWORD=kothar_secret_change_me
POSTGRES_DB=kothar_trace
POSTGRES_PORT=5440
POSTGRES_HOST=kothar_postgres

# --- Redis ---
REDIS_HOST=kothar_redis
REDIS_PORT=6381
REDIS_PASSWORD=kothar_redis_change_me

# --- Neo4j ---
NEO4J_USER=neo4j
NEO4J_PASSWORD=kothar_neo4j_change_me
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_URI=bolt://kothar_neo4j:7687

# --- ChromaDB ---
CHROMA_HOST=kothar_chromadb
CHROMA_PORT=8000
CHROMA_TOKEN=kothar_chroma_token_change_me

# --- API ---
API_HOST=0.0.0.0
API_PORT=8080
API_SECRET_KEY=kothar_api_secret_change_me
ENVIRONMENT=development

# --- Frontend ---
FRONTEND_PORT=3030
VITE_API_BASE_URL=http://localhost:8080

# --- LLM Keys ---
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=AIzaSy...

# --- Vault (Cofre Obsidian) ---
VAULT_PATH=/home/bruno/cofre

# --- Kothar ---
KOTHAR_VERSION=4.0.0
LOG_LEVEL=INFO
SESSION_TTL_SECONDS=86400

# --- Sistema Um (Decisor Local) ---
DECISOR_OLLAMA_URL=http://kothar_ollama:11434
DECISOR_MODELO=qwen2.5:7b
DECISOR_TIMEOUT=3.0
