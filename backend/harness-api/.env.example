# Kothar Trace Backend

# Porta do servidor
PORT=3000

# Caminho do banco SQLite (relativo ou absoluto)
DB_PATH=./banco/traces.db

# Segredo JWT (TROQUE EM PRODUÇÃO!)
JWT_SECRET=mude-este-segredo-em-producao-use-32-chars-min

# Tempo de expiração do token (em segundos, padrão 30 dias)
JWT_EXPIRES_IN=2592000

# Origem CORS permitida (frontend Vite)
CORS_ORIGIN=http://localhost:5180

# Ambiente
NODE_ENV=development
