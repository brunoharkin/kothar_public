# ═══════════════════════════════════════════════════════════════════════
# KOTHAR MODEL ROUTER - CONFIGURAÇÃO DE API KEYS
# Copie este arquivo para .env e preencha com suas chaves
# ═══════════════════════════════════════════════════════════════════════

# ANTHROPIC (Claude)
ANTHROPIC_API_KEY=sk-ant-apixxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OPENAI (GPT)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GOOGLE (Gemini)
GOOGLE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ═══════════════════════════════════════════════════════════════════════
# MODEL ROUTING - SELEÇÃO DE MODELOS POR TIER
# ═══════════════════════════════════════════════════════════════════════

# PROVIDER PREFERIDO (anthropic, openai, google)
PREFERRED_PROVIDER=anthropic

# TIER 1: Fast & Cheap (tarefas simples)
# Ex: "mostra logs", "lista arquivos", "traduz"
MODEL_TIER1=claude-haiku-4-20250514
MODEL_TIER1_COST=0.00025
# Alternativas GPT:
MODEL_TIER1_GPT=gpt-4o-mini
MODEL_TIER1_GOOGLE=gemini-flash-1.5

# TIER 2: Balanced (tarefas médias)
# Ex: "cria endpoint", "implementa feature"
MODEL_TIER2=claude-sonnet-5-20250514
MODEL_TIER2_COST=0.003
# Alternativas GPT:
MODEL_TIER2_GPT=gpt-4o
MODEL_TIER2_GOOGLE=gemini-1.5-pro

# TIER 3: Premium (tarefas complexas)
# Ex: "corrige bug crítico", "projeta arquitetura"
MODEL_TIER3=claude-opus-5-20250514
MODEL_TIER3_COST=0.015
# Alternativas GPT:
MODEL_TIER3_GPT=gpt-5
MODEL_TIER3_GOOGLE=gemini-ultra-1.0

# ═══════════════════════════════════════════════════════════════════════
# MODELOS ALTERNATIVOS (quando preferir outro provider)
# ═══════════════════════════════════════════════════════════════════════

# Claude
CLAUDE_HAIKU=claude-haiku-4-20250514
CLAUDE_SONNET=claude-sonnet-5-20250514
CLAUDE_OPUS=claude-opus-5-20250514

# GPT
GPT_4O_MINI=gpt-4o-mini
GPT_4O=gpt-4o
GPT_5=gpt-5

# Gemini
GEMINI_FLASH=gemini-flash-1.5
GEMINI_PRO=gemini-1.5-pro
GEMINI_ULTRA=gemini-ultra-1.0
