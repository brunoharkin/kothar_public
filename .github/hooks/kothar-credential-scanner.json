{
  "kothar-credential-scanner": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel)}\"; python3 \"$ROOT/hooks/agy-credential-scanner.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
