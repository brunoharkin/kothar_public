{
  "kothar-post-codegen-validate": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel)}\"; KOTHAR_PROJECT_DIR=\"$ROOT\" python3 \"$ROOT/hooks/post-codegen-validate.py\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
